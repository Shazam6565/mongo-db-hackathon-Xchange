# Local development only. The API binds to loopback.
HOST=127.0.0.1
PORT=4317
TEAM_API_URL=http://127.0.0.1:4317
TEAM_API_TOKEN=local-demo-token
TEAM_ID=demo-team
PROJECT_ID=event-platform
ENGINEER_ID=engineer-a

# Set STORAGE_MODE=mongodb to require a database; startup will fail if its URI is missing.
# STORAGE_MODE=mongodb
# With no URI or explicit mode, the API uses disposable in-memory demo data.
# With a URI, it uses an empty MongoDB collection; it does not seed demo data.
MONGODB_URI=
MONGODB_DATABASE=team_memory_harness
# Safe display label only, never a connection string.
MONGODB_LABEL=MongoDB

# Planned integrations; not consumed by this skeleton yet.
VECTOR_INDEX_NAME=lessons_vector
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
